<?xml version="1.0"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20230324/MODEL/" id="eligibility" name="Eligibility" namespace="urn:moondmn:example">
  <inputData id="age" name="Applicant Age"><variable name="Applicant Age" typeRef="number"/></inputData>
  <decision id="eligible" name="Eligible">
    <informationRequirement><requiredInput href="#age"/></informationRequirement>
    <literalExpression><text>Applicant Age &gt;= 18</text></literalExpression>
  </decision>
</definitions>
